PORT=3000
DEFAULT_RADIUS_KM=50
CRON_SCHEDULE=0 */3 * * *

# Weather: mixed (default) fetches multiple models for comparison
WEATHER_PROVIDER=mixed
WEATHER_MODELS=lam,hrrr,gfs,open-meteo
WEATHER_PRIMARY_MODEL=lam
IGETWIND_BASE_URL=https://igetwind.com

# Spots from iGetwind (syncs all ~500 community spots on startup)
IGETWIND_SYNC_SPOTS=true
# Set to e.g. 150 to limit sync to radius around center; 0 = worldwide
IGETWIND_SYNC_RADIUS_KM=0
IGETWIND_SYNC_CENTER_LAT=45.5017
IGETWIND_SYNC_CENTER_LNG=-73.5673

# Session hazards & observations
OBSERVATION_CACHE_TTL_MS=300000
STATION_MAX_DISTANCE_KM=15
SESSION_WARNING_HOURS=3
SESSION_FINISH_BUFFER_MIN=30
PRECIP_BLOCK_MM=0.3

# Spot media — inline thumbnails (Wikimedia Commons is default; no API key required)
# Optional Google Custom Search JSON API fallback (closed to new Google customers)
# Max geosearch radius in metres (geo-first; default 2000, tiers 500/1200/max)
# COMMONS_GEORADIUS_M=2000
# Required for OSM Overpass (direction inference). Use a real app id + contact.
# WINDMATE_USER_AGENT=Windmate/1.0 (your@email.example)
# OVERPASS_MIN_INTERVAL_MS=2500
# OVERPASS_RETRY_DELAY_MS=30000
# INFERENCE_BACKFILL_DELAY_MS=3000
# GOOGLE_CSE_API_KEY=
# GOOGLE_CSE_CX=
# INTEL_CACHE_TTL_MS=3600000

# Gemini — spot catalog discovery + profile/day intel (requires key in .env, never commit)
# GEMINI_API_KEY=   # Google AI Studio key (usually starts with AIzaSy…)
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODEL=gemini-3.6-flash
# GEMINI_USE_INTERACTIONS=true
# GEMINI_MODEL_FALLBACK_ON_404=true
# Opt in — off by default so a new project is not hit on map open / server quirks
# GEMINI_CATALOG_ENABLED=true
# GEMINI_CATALOG_USE_SEARCH=true
# Set CATALOG_USE_SEARCH=false for lighter catalog calls on free tier (no live web search)
# INTEL_PARSER_ENABLED=true
# GEMINI_INTEL_USE_SEARCH=true
# Set INTEL_USE_SEARCH=false to skip search on Spot Details, or rely on auto fallback when search quota 429s
# GEMINI_MIN_INTERVAL_MS=15000
# GEMINI_QUOTA_BACKOFF_MS=120000
# GEMINI_MAX_429_RETRIES=0
# SPOT_DISCOVERY_TTL_MS=604800000
# SPOT_DISCOVERY_MIN_SPAN_KM=25
# INTEL_PROFILE_TTL_MS=2592000000
# INTEL_DAY_TTL_MS=3600000

# Departure planner — set for live traffic on session day (otherwise ~distance/55 km/h)
# GOOGLE_MAPS_API_KEY=
# SESSION_DAY_TRAVEL_CACHE_TTL_MS=300000
TRAVEL_CACHE_TTL_MS=1800000
DEFAULT_RIG_MINUTES=20
DEFAULT_DEPARTURE_BUFFER_MINUTES=5
HAVERSINE_DRIVE_SPEED_KMH=55
# WINDY_API_KEY=
# WINDY_MODEL=canHrdps
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
